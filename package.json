{
  "name": "tsqh-mvp",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "description": "A deterministic sequential multi-agent guardrail controller.",
  "main": "./dist/cli.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "tsqh": "dist/cli.js"
  },
  "files": [
    "README.md",
    "dist/",
    "schemas/",
    "workflows/simple/README.md",
    "workflows/simple/workflow.json",
    "workflows/simple/prompts/",
    "workflows/tdd-pipeline/README.md",
    "workflows/tdd-pipeline/workflow.json",
    "workflows/tdd-pipeline/prompts/",
    "knip.json",
    "stryker.config.mjs",
    "sonar-policy.json",
    "sonar-project.properties"
  ],
  "exports": {
    ".": "./dist/cli.js",
    "./schemas/project-config.schema.json": "./schemas/project-config.schema.json",
    "./schemas/workflow.schema.json": "./schemas/workflow.schema.json",
    "./workflows/simple/README.md": "./workflows/simple/README.md",
    "./workflows/simple/workflow.json": "./workflows/simple/workflow.json",
    "./workflows/simple/prompts/*": "./workflows/simple/prompts/*",
    "./workflows/tdd-pipeline/README.md": "./workflows/tdd-pipeline/README.md",
    "./workflows/tdd-pipeline/workflow.json": "./workflows/tdd-pipeline/workflow.json",
    "./workflows/tdd-pipeline/prompts/*": "./workflows/tdd-pipeline/prompts/*",
    "./knip.json": "./knip.json",
    "./stryker.config.mjs": "./stryker.config.mjs",
    "./sonar-policy.json": "./sonar-policy.json",
    "./sonar-project.properties": "./sonar-project.properties"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/mark-cli-executable.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "pnpm build && vitest run",
    "test:unit": "vitest run test/domain test/config",
    "quality:architecture": "node scripts/check-architecture.mjs",
    "quality:quick": "node scripts/run-quality.mjs quick",
    "quality:coverage": "node scripts/run-quality.mjs coverage",
    "quality:crap": "node scripts/run-quality.mjs crap",
    "quality:knip": "node scripts/run-quality.mjs knip",
    "quality:mutation": "node scripts/run-quality.mjs mutation",
    "quality:sonar": "node scripts/run-quality.mjs sonar",
    "quality:full": "node scripts/run-quality.mjs full",
    "tsqh": "node --enable-source-maps dist/cli.js"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@azaru/tscrap": "0.1.2",
    "@sonar/scan": "5.0.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.11",
    "knip": "6.32.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.17.0"
}
