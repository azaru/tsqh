{
  "schemaVersion": 1,
  "workflow": {
    "id": "simple",
    "entryStepId": "tester",
    "steps": {
      "tester": {
        "type": "agent",
        "role": "tester",
        "maxVisits": 1,
        "onCompleted": "tester-validation"
      },
      "tester-validation": {
        "type": "gate",
        "profile": "tester-validation",
        "maxVisits": 1,
        "onPassed": "implementer",
        "onFailed": "blocked"
      },
      "implementer": {
        "type": "agent",
        "role": "implementer",
        "maxVisits": 3,
        "onCompleted": "quick"
      },
      "quick": {
        "type": "gate",
        "profile": "quick",
        "maxVisits": 3,
        "onPassed": "passed",
        "onFailed": "implementer"
      },
      "passed": {
        "type": "terminal",
        "outcome": "passed"
      },
      "blocked": {
        "type": "terminal",
        "outcome": "blocked"
      }
    }
  },
  "roles": {
    "tester": {
      "provider": "codex",
      "promptPath": "prompts/tester.md",
      "allowedPathPrefixes": ["test/"]
    },
    "implementer": {
      "provider": "codex",
      "promptPath": "prompts/implementer.md",
      "allowedPathPrefixes": [
        "src/",
        "scripts/",
        "schemas/",
        "workflows/tdd-pipeline/",
        "package.json",
        "pnpm-lock.yaml",
        "vitest.config.ts",
        "tsconfig.json",
        "tsconfig.test.json",
        "eslint.config.mjs",
        "dependency-cruiser.json",
        "gitleaks.toml",
        "README.md",
        "STATUS.md",
        "STATUS-HISTORY.md"
      ]
    }
  },
  "providers": {
    "codex": {
      "type": "command",
      "executable": "codex",
      "args": ["exec", "--sandbox", "workspace-write", "-"],
      "promptTransport": "stdin",
      "timeoutMs": 1800000
    }
  },
  "profiles": {
    "quick": {
      "executable": "pnpm",
      "args": ["quality:quick"],
      "timeoutMs": 900000
    },
    "tester-validation": {
      "executable": "node",
      "args": ["workflows/simple/validate-tester.mjs"],
      "timeoutMs": 1800000
    }
  }
}
