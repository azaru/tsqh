{
  "schemaVersion": 1,
  "workflow": {
    "id": "example",
    "entryStepId": "implement",
    "steps": {
      "implement": {
        "type": "agent",
        "role": "implementer",
        "maxVisits": 1,
        "onCompleted": "quick"
      },
      "quick": {
        "type": "gate",
        "profile": "quick",
        "maxVisits": 3,
        "onPassed": "coverage",
        "onFailed": "repair"
      },
      "coverage": {
        "type": "gate",
        "profile": "coverage",
        "maxVisits": 3,
        "onPassed": "crap",
        "onFailed": "repair"
      },
      "crap": {
        "type": "gate",
        "profile": "crap",
        "maxVisits": 3,
        "onPassed": "knip",
        "onFailed": "repair"
      },
      "knip": {
        "type": "gate",
        "profile": "knip",
        "maxVisits": 3,
        "onPassed": "mutation",
        "onFailed": "repair"
      },
      "mutation": {
        "type": "gate",
        "profile": "mutation",
        "maxVisits": 3,
        "onPassed": "sonar",
        "onFailed": "repair"
      },
      "sonar": {
        "type": "gate",
        "profile": "sonar",
        "maxVisits": 3,
        "onPassed": "passed",
        "onFailed": "repair"
      },
      "repair": {
        "type": "agent",
        "role": "repairer",
        "maxVisits": 2,
        "onCompleted": "quick"
      },
      "passed": {
        "type": "terminal",
        "outcome": "passed"
      }
    }
  },
  "roles": {
    "implementer": {
      "provider": "codex",
      "promptPath": "swarm-forge-lite/prompts/implementer.md",
      "allowedPathPrefixes": ["src/", "test/"]
    },
    "repairer": {
      "provider": "codex",
      "promptPath": "swarm-forge-lite/prompts/repairer.md",
      "allowedPathPrefixes": ["src/", "test/"]
    }
  },
  "providers": {
    "codex": {
      "type": "command",
      "executable": "codex",
      "args": ["exec", "--sandbox", "workspace-write", "-"],
      "promptTransport": "stdin",
      "timeoutMs": 900000
    }
  },
  "profiles": {
    "quick": {
      "executable": "pnpm",
      "args": ["quality:quick"],
      "timeoutMs": 900000
    },
    "coverage": {
      "executable": "pnpm",
      "args": ["quality:coverage"],
      "timeoutMs": 900000
    },
    "crap": {
      "executable": "pnpm",
      "args": ["quality:crap"],
      "timeoutMs": 900000
    },
    "knip": {
      "executable": "pnpm",
      "args": ["quality:knip"],
      "timeoutMs": 900000
    },
    "mutation": {
      "executable": "pnpm",
      "args": ["quality:mutation"],
      "timeoutMs": 3600000
    },
    "sonar": {
      "executable": "pnpm",
      "args": ["quality:sonar"],
      "environmentKeys": ["SONAR_HOST_URL", "SONAR_TOKEN", "SONAR_ORGANIZATION"],
      "timeoutMs": 360000
    }
  }
}
