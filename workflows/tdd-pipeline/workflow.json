{
  "schemaVersion": 1,
  "workflow": {
    "id": "tdd-pipeline",
    "entryStepId": "specifier",
    "steps": {
      "specifier": {
        "type": "agent",
        "role": "specifier",
        "model": "gpt-5.6-luna",
        "effort": "max",
        "maxVisits": 1,
        "onCompleted": "tester"
      },
      "tester": {
        "type": "agent",
        "role": "tester",
        "maxVisits": 1,
        "onCompleted": "implementer"
      },
      "implementer": {
        "type": "agent",
        "role": "implementer",
        "maxVisits": 1,
        "onCompleted": "quick-implementer"
      },
      "quick-implementer": {
        "type": "gate",
        "profile": "quick",
        "maxVisits": 3,
        "onPassed": "cleaner",
        "onFailed": "implementation-rework"
      },
      "cleaner": {
        "type": "agent",
        "role": "cleaner",
        "maxVisits": 1,
        "onCompleted": "quick-cleaner"
      },
      "quick-cleaner": {
        "type": "gate",
        "profile": "quick",
        "maxVisits": 3,
        "onPassed": "architect",
        "onFailed": "cleanup-rework"
      },
      "architect": {
        "type": "agent",
        "role": "architect",
        "model": "gpt-5.6-luna",
        "effort": "max",
        "maxVisits": 1,
        "onCompleted": "quick-architect"
      },
      "quick-architect": {
        "type": "gate",
        "profile": "quick",
        "maxVisits": 3,
        "onPassed": "hardener",
        "onFailed": "hardening-rework"
      },
      "hardener": {
        "type": "agent",
        "role": "hardener",
        "maxVisits": 1,
        "onCompleted": "quick-hardener"
      },
      "quick-hardener": {
        "type": "gate",
        "profile": "quick",
        "maxVisits": 3,
        "onPassed": "full",
        "onFailed": "hardening-rework"
      },
      "full": {
        "type": "gate",
        "profile": "full",
        "maxVisits": 3,
        "onPassed": "passed",
        "onFailed": "hardening-rework"
      },
      "implementation-rework": {
        "type": "agent",
        "role": "implementer",
        "maxVisits": 2,
        "onCompleted": "quick-implementer"
      },
      "cleanup-rework": {
        "type": "agent",
        "role": "cleaner",
        "maxVisits": 2,
        "onCompleted": "quick-cleaner"
      },
      "hardening-rework": {
        "type": "agent",
        "role": "hardener",
        "maxVisits": 2,
        "onCompleted": "quick-hardener"
      },
      "passed": {
        "type": "terminal",
        "outcome": "passed"
      }
    }
  },
  "roles": {
    "specifier": {
      "provider": "codex",
      "promptPath": "prompts/specifier.md",
      "allowedPathPrefixes": []
    },
    "tester": {
      "provider": "codex",
      "promptPath": "prompts/tester.md",
      "allowedPathPrefixes": ["test/"]
    },
    "implementer": {
      "provider": "codex",
      "promptPath": "prompts/implementer.md",
      "allowedPathPrefixes": ["src/"]
    },
    "cleaner": {
      "provider": "codex",
      "promptPath": "prompts/cleaner.md",
      "allowedPathPrefixes": ["src/"]
    },
    "architect": {
      "provider": "codex",
      "promptPath": "prompts/architect.md",
      "allowedPathPrefixes": ["src/"]
    },
    "hardener": {
      "provider": "codex",
      "promptPath": "prompts/hardener.md",
      "allowedPathPrefixes": ["src/"]
    }
  },
  "providers": {
    "codex": {
      "type": "command",
      "executable": "codex",
      "args": [
        "exec",
        "--sandbox",
        "workspace-write",
        "--model",
        "{model}",
        "--config",
        "model_reasoning_effort=\"{effort}\"",
        "-"
      ],
      "model": "gpt-5.6-luna",
      "effort": "max",
      "promptTransport": "stdin",
      "timeoutMs": 900000
    }
  },
  "profiles": {
    "quick": {
      "executable": "pnpm",
      "args": ["quality:quick"],
      "timeoutMs": 900000
    },
    "full": {
      "executable": "pnpm",
      "args": ["quality:full"],
      "environmentKeys": ["SONAR_HOST_URL", "SONAR_TOKEN", "SONAR_ORGANIZATION"],
      "timeoutMs": 3600000
    }
  }
}
